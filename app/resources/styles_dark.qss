/* Dark theme - improved */
QMainWindow {
    background-color: #0b1220;
    color: #e6eef6;
    font-family: "Inter", "Segoe UI", "Tahoma", sans-serif;
    font-size: 14px;
}

/* Sidebar buttons */
#SidebarButton {
    background-color: transparent;
    color: #dbeafe;
    border: none;
    padding: 12px 14px;
    border-radius: 8px;
    text-align: left;
    min-height: 40px;
}
#SidebarButton:hover { background-color: rgba(255,255,255,0.03); }
#SidebarButton:checked { background-color: rgba(16,185,129,0.12); color: #a7f3d0; }

/* Card styled as a button for interactivity */
QPushButton#Card {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #111827, stop:1 #111827);
    border-radius: 12px;
    padding: 14px;
    margin: 8px;
    border: 1px solid rgba(255,255,255,0.03);
    text-align: left;
}
QPushButton#Card:hover { background-color: #0f1724; }
QPushButton#Card QLabel#CardTitle { color: #9ca3af; font-size: 13px; }
QPushButton#Card QLabel#CardValue { color: #ffffff; font-size: 28px; font-weight: 700; }

/* Table */
QTableWidget {
    background-color: transparent;
    gridline-color: rgba(255,255,255,0.03);
    color: #e6eef6;
}
QTableWidget::item { padding: 8px; }
QTableView QTableCornerButton::section { background: transparent; }
QHeaderView::section {
    background-color: transparent;
    color: #cbd5e1;
    padding: 8px;
    border: none;
}
QTableWidget::item:selected { background: rgba(16,185,129,0.12); }

/* Nice switch-like checkbox */
QCheckBox::indicator {
    width: 44px; height: 24px; border-radius: 12px;
    background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.04);
}
QCheckBox::indicator:checked { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #06b6d4, stop:1 #10b981); }

/* Chart view hints */
QChartView { background: transparent; }

