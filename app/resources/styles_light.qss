/* Light theme - improved */
QMainWindow {
    background-color: #f6f9fc;
    color: #0b1220;
    font-family: "Inter", "Segoe UI", "Tahoma", sans-serif;
    font-size: 14px;
}

/* Sidebar */
#SidebarButton {
    background-color: transparent;
    color: #0b1220;
    border: none;
    padding: 12px 14px;
    border-radius: 8px;
    text-align: left;
    min-height: 40px;
}
#SidebarButton:hover { background-color: rgba(15,23,42,0.03); }
#SidebarButton:checked { background-color: rgba(14,165,233,0.08); color: #0369a1; }

/* Card styled as a button for interactivity */
QPushButton#Card {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #ffffff, stop:1 #ffffff);
    border-radius: 12px;
    padding: 14px;
    margin: 8px;
    border: 1px solid #e6edf3;
    text-align: left;
}
QPushButton#Card:hover { background-color: #f8fafc; }
QPushButton#Card QLabel#CardTitle { color: #6b7280; font-size: 13px; }
QPushButton#Card QLabel#CardValue { color: #0f172a; font-size: 28px; font-weight: 700; }

/* Table */
QTableWidget {
    background-color: transparent;
    gridline-color: #eef2f7;
    color: #0b1220;
}
QTableWidget::item { padding: 8px; }
QHeaderView::section {
    background-color: transparent;
    color: #0f172a;
    padding: 8px;
    border: none;
}
QTableWidget::item:selected { background: rgba(14,165,233,0.08); }

/* Nice switch-like checkbox */
QCheckBox::indicator {
    width: 44px; height: 24px; border-radius: 12px;
    background: rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.06);
}
QCheckBox::indicator:checked { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #06b6d4, stop:1 #0369a1); }

QChartView { background: transparent; }

